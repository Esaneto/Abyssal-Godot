; Engine configuration file.
; Abyssal native client - independent of the current JavaScript client.
config_version=5

[application]
config/name="Abyssal"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.008, 0.035, 0.073, 1)

[input]
move_up={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]
}

extract={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":71)]
}
open_inventory={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":73)]
}
open_map={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":77)]
}
